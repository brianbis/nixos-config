@@ -0,0 +1,17 @@
+//! Messages "refresh": trigger an immediate one-shot store-sync via the broker.
+//!
+//! Mirrors `contacts::sync_contacts_now`. The GUI's refresh / polling only re-reads
+//! the local store (`list_messages` / `threads`), which never shows new messages by
+//! itself; this command is what actually fetches from the phone.
+use super::CommandError;
+
+/// Runs a one-shot MAP sync through the broker at `addr`, returning the report.
+///
+/// # Errors
+///
+/// Returns [`CommandError`] if the broker can't be reached or rejects the request.
+#[tauri::command]
+#[specta::specta]
+pub async fn sync_messages_now(addr: String) -> Result<String, CommandError> {
+    Ok(broker_client::sync(&addr, None).await?)
+}
