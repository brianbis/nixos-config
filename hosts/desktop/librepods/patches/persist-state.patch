+// --- librepods-persist-state patch: thin last-known state persistence --------
+// Each MAC owns one flat "last known" record in state.json (the same file the
+// LE monitor's PPM handler updates; see le.rs). Every field is the last REAL
+// value observed: a null observation never overwrites a stored value, and the
+// case battery is only real while the case is connected. `last_seen` is the
+// most recent update of any kind. Readers (tray, notify watcher, connect
+// order) render the record as-is. Written unconditionally (headless-safe).
+fn state_path() -> std::path::PathBuf {
+    let base = std::env::var("XDG_STATE_HOME")
+        .unwrap_or_else(|_| format!("{}/.local/state", std::env::var("HOME").unwrap_or_default()));
+    std::path::Path::new(&base).join("librepods").join("state.json")
+}
+
+fn read_record(mac: &str) -> serde_json::Map<String, serde_json::Value> {
+    std::fs::read_to_string(state_path())
+        .ok()
+        .and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())
+        .and_then(|v| v.as_object().cloned())
+        .and_then(|m| m.get(mac).cloned())
+        .and_then(|v| v.as_object().cloned())
+        .unwrap_or_default()
+}
+
+// Last-real-wins: only a non-null observation overwrites a stored value.
+fn merge(rec: &mut serde_json::Map<String, serde_json::Value>, key: &str, val: &serde_json::Value) {
+    if !val.is_null() {
+        rec.insert(key.to_string(), val.clone());
+    }
+}
+
+fn write_record(mac: &str, rec: &serde_json::Map<String, serde_json::Value>) {
+    let path = state_path();
+    let mut map: serde_json::Map<String, serde_json::Value> = std::fs::read_to_string(&path)
+        .ok()
+        .and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())
+        .and_then(|v| v.as_object().cloned())
+        .unwrap_or_default();
+    map.insert(mac.to_string(), serde_json::Value::Object(rec.clone()));
+    if let Some(parent) = path.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    let tmp = path.with_extension("json.tmp");
+    if let Err(e) = std::fs::write(
+            &tmp,
+            serde_json::to_string_pretty(&serde_json::Value::Object(map)).unwrap(),
+        )
+        .and_then(|_| std::fs::rename(&tmp, &path))
+    {
+        debug!("Failed to write librepods state file: {}", e);
+    }
+}
+// --- end librepods-persist-state patch ---------------------------------------
