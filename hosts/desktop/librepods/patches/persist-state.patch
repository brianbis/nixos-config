+// --- librepods-persist-state patch: helpers ---------------------------------
+// Persist parsed Proximity Pairing Message (PPM) state to a JSON file so that
+// external consumers (KDE notifications, the Ctrl+Shift+C connect shortcut)
+// can read it. Written unconditionally (NOT gated by the tray handle) so it
+// works in headless (--no-tray) mode.
+fn state_path() -> std::path::PathBuf {
+    let base = std::env::var("XDG_STATE_HOME")
+        .unwrap_or_else(|_| format!("{}/.local/state", std::env::var("HOME").unwrap_or_default()));
+    std::path::Path::new(&base).join("librepods").join("state.json")
+}
+
+fn write_state(mac: &str, entry: &serde_json::Value) {
+    let path = state_path();
+    let mut map: serde_json::Map<String, serde_json::Value> = std::fs::read_to_string(&path)
+        .ok()
+        .and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())
+        .and_then(|v| v.as_object().cloned())
+        .unwrap_or_default();
+    let existing = map.get(mac).cloned();
+    let now = entry.get("last_seen").and_then(|v| v.as_u64()).unwrap_or(0);
+    let changed = existing.as_ref() != Some(entry);
+    let mut new_entry = entry.clone();
+    if let Some(obj) = new_entry.as_object_mut() {
+        if changed {
+            obj.insert("last_change".to_string(), serde_json::json!(now));
+        }
+        // Preserve the precise AACP battery sub-object (written by the AACP
+        // handler in aacp.rs) across coarse PPM updates, which only carry
+        // ~10%-granularity readings.
+        if let Some(aacp) = existing.as_ref().and_then(|e| e.get("aacp").cloned()) {
+            obj.insert("aacp".to_string(), aacp);
+        }
+    }
+    map.insert(mac.to_string(), new_entry);
+    if let Some(parent) = path.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    let tmp = path.with_extension("json.tmp");
+    if let Err(e) = std::fs::write(
+            &tmp,
+            serde_json::to_string_pretty(&serde_json::Value::Object(map)).unwrap(),
+        )
+        .and_then(|_| std::fs::rename(&tmp, &path))
+    {
+        debug!("Failed to write librepods state file: {}", e);
+    }
+}
+// --- end librepods-persist-state patch --------------------------------------
