+        format: Format::S16le,
+        rate: 48000,
+        channels: 2,
+    };
+    let mut stream = match Stream::new(&mut context, "librepods-silence", &spec, None) {
+        Some(s) => s,
+        None => {
+            warn!("Silence stream: failed to create stream");
+            return;
+        }
+    };
+    if stream
+        .connect_playback(Some(sink), None, stream::FlagSet::empty(), None, None)
+        .is_err()
+    {
+        warn!("Silence stream: failed to connect playback to {}", sink);
+        return;
+    }
+    info!("Silence stream open to {}", sink);
+
+    // ~100 ms of 16-bit stereo silence at 48 kHz (4800 frames * 2 ch * 2 bytes).
+    // Zeros are inaudible regardless of the negotiated sample format, and the length
+    // is a multiple of the frame size (4 bytes for S16LE stereo).
+    let bytes: Vec<u8> = vec![0; 4800 * 2 * 2];
+    loop {
+        if stop.load(Ordering::SeqCst) || suppressed.load(Ordering::SeqCst) {
+            break;
+        }
+        // Append to the output buffer (spec 6.1: the write paces us to real-time).
+        if stream.write_copy(&bytes, 0, SeekMode::Relative).is_err() {
+            // Stream torn down; let the caller restart.
+            break;
+        }
+        // Iterate the mainloop so the write is processed, and yield the CPU.
+        mainloop.iterate(false);
+        std::thread::sleep(Duration::from_millis(10));
+    }
 }
 
 pub fn transition_sink_volume(sink_name: &str, target_volume: u32) -> bool {
diff --git a/linux-rust/src/ownership.rs b/linux-rust/src/ownership.rs
new file mode 100644
index 0000000..49a8d31
--- /dev/null
+++ b/linux-rust/src/ownership.rs
@@ -0,0 +1,461 @@
+//! Ownership arbitration between the Linux host and a peer (iPhone) sharing the
+//! AirPods (spec 5).
+//!
+//! The host is not a first-class participant in Apple's ownership negotiation: it
+//! must claim explicitly, detect when the peer wants the device, yield gracefully,
+//! and reclaim afterwards — while avoiding the firmware watchdogs that tear down the
+//! link if the dance is done wrong.
+//!
+//! This module implements the state machine from spec 5:
+//!
+//! ```text
+//!   LINUX_OWNS  --AUDIO_SOURCE(peer, CALL|MEDIA) / peer B -> 0x17-->  YIELDING
+//!   YIELDING    --(RELEASE sent)--------------------------------->  PEER_OWNS
+//!   PEER_OWNS   --peer B < 0x17 AND guard elapsed---------------->  RECLAIMING
+//!   RECLAIMING  --(CLAIM sent, A2DP up)-------------------------->  LINUX_OWNS
+//! ```
+//!
+//! Two rules that are easy to get wrong and that cost real bugs (spec 5):
+//! * A `NONE` audio source during a peer call is meaningless — the firmware emits it
+//!   periodically (~20 s) while a call is in progress. Always cross-check the peer's
+//!   B-field before acting on `NONE`.
+//! * Reclaim must be guarded against concurrency — a single `reclaim_in_progress`
+//!   flag, cleared on *every* exit path, so two timers cannot run two codec warm-ups
+//!   in parallel.
+
+use crate::bluetooth::aacp::{
+    AACPManager, AudioSource, ControlCommandIdentifiers, EarDetectionStatus,
+};
+use crate::media_controller::MediaController;
+use log::{debug, info, warn};
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use tokio::sync::{mpsc, Mutex};
+
+/// How long to wait after the peer appears to release before reclaiming (spec 7.3).
+const RECLAIM_GUARD: Duration = Duration::from_secs(3);
+
+/// Peer B-field meaning "active owner" — on a call or playing media (spec 3.4, 5).
+const PEER_ACTIVE: u8 = 0x17;
+
+/// Ghost-session variant A (spec 8.2): a peer that was engaged (B >= 0x10) and then
+/// stayed disengaged (B < 0x10) for longer than this is a ghost — it dropped the
+/// session but the firmware still thinks it is attached.
+const GHOST_A_DISENGAGED: Duration = Duration::from_secs(17);
+
+/// Ghost-session variant B (spec 8.2): no non-local peer present for longer than this
+/// is a ghost — the peer vanished entirely but a stale session lingers.
+const GHOST_B_ABSENT: Duration = Duration::from_secs(30);
+
+/// How often the ghost-session monitor re-evaluates the conditions (spec 8.2).
+const GHOST_MONITOR_INTERVAL: Duration = Duration::from_secs(1);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum OwnershipState {
+    /// Our B in {0x00, 0x03}, peer B <= 0x15; audio on Linux.
+    LinuxOwns,
+    /// We sent RELEASE and deactivated A2DP.
+    Yielding,
+    /// Peer B = 0x17; audio on iPhone. Periodic `NONE` packets are ignored.
+    PeerOwns,
+    /// We are (re)asserting: CLAIM sent, A2DP being activated.
+    Reclaiming,
+}
+
+#[derive(Debug)]
+struct ArbiterState {
+    state: OwnershipState,
+    /// Single in-flight reclaim guard (spec 5). Cleared on every exit path.
+    reclaim_in_progress: bool,
+    /// A reclaim guard timer is armed and counting down (spec 7.3).
+    guard_armed: bool,
+    /// Latest ear-detection statuses, for the eviction-vs-role-swap guard (spec 7.4).
+    ear: Vec<EarDetectionStatus>,
+    /// Ghost session detected (spec 8.2). Surfaced to the user; no auto-action.
+    ghost_session: bool,
+    /// Human-readable reason for the current ghost session (which variant / peer).
+    ghost_reason: Option<String>,
+    /// Last time each non-local peer was observed engaged (B >= 0x10). Drives variant A.
+    peer_last_engaged: HashMap<String, Instant>,
+    /// Last time each non-local peer transitioned to disengaged (B < 0x10) after having
+    /// been engaged. Drives variant A.
+    peer_last_disengaged: HashMap<String, Instant>,
+    /// Last time any non-local peer was present. Drives variant B.
+    last_peer_seen: Option<Instant>,
+}
+
+impl ArbiterState {
+    fn new() -> Self {
+        ArbiterState {
+            state: OwnershipState::LinuxOwns,
+            reclaim_in_progress: false,
+            guard_armed: false,
+            ear: Vec::new(),
+            ghost_session: false,
+            ghost_reason: None,
+            peer_last_engaged: HashMap::new(),
+            peer_last_disengaged: HashMap::new(),
+            last_peer_seen: None,
+        }
+    }
+}
+
+#[derive(Clone)]
+pub struct OwnershipArbiter {
+    aacp: AACPManager,
+    media: Arc<Mutex<MediaController>>,
+    command_tx: mpsc::UnboundedSender<(ControlCommandIdentifiers, Vec<u8>)>,
+    state: Arc<Mutex<ArbiterState>>,
+}
+
+impl OwnershipArbiter {
+    pub fn new(
+        aacp: AACPManager,
+        media: Arc<Mutex<MediaController>>,
+        command_tx: mpsc::UnboundedSender<(ControlCommandIdentifiers, Vec<u8>)>,
+    ) -> Self {
+        OwnershipArbiter {
+            aacp,
+            media,
+            command_tx,
+            state: Arc::new(Mutex::new(ArbiterState::new())),
+        }
+    }
+
+    pub async fn current_state(&self) -> OwnershipState {
+        self.state.lock().await.state
+    }
+
+    /// Is any non-local peer the active owner (B >= 0x17)?
+    async fn any_peer_active(&self) -> bool {
+        let peers = self.aacp.peers().await;
+        peers.iter().any(|p| p.info2 >= PEER_ACTIVE)
+    }
+
+    /// Feed the latest `CONNECTED_DEVICES` snapshot (spec 5, 7.4).
+    pub async fn on_connected_devices(&self, new: Vec<crate::bluetooth::aacp::ConnectedDevice>) {
+        let local = self.aacp.local_mac().await;
+        let local_rev = self.aacp.local_mac_reversed().await;
+        let is_local = |mac: &str| mac == local || local_rev.as_deref() == Some(mac);
+
+        // Eviction vs role-swap guard (spec 7.4): our own MAC's A field == 0x00 can
+        // mean "evicted" or "pods swapped primary/secondary". The latter is harmless;
+        // only treat it as eviction when no pod is in an ear.
+        let own = new.iter().find(|d| is_local(&d.mac));
+        if let Some(own) = own
+            && own.is_evicted()
+        {
+            let any_in_ear = self
+                .state
+                .lock()
+                .await
+                .ear
+                .iter()
+                .any(|s| *s == EarDetectionStatus::InEar);
+            if any_in_ear {
+                debug!("Own A=0x00 but a pod is in ear: role swap, not eviction (spec 7.4).");
+            } else {
+                info!("Own A=0x00 with no pod in ear: treating as eviction; reclaiming.");
+                self.maybe_reclaim().await;
+            }
+        }
+
+        // Detect peer engagement -> yield (spec 5).
+        let peer_active = new.iter().any(|d| !is_local(&d.mac) && d.info2 >= PEER_ACTIVE);
+        if peer_active {
+            info!("Peer became active owner (B >= 0x17); yielding.");
+            self.yield_ownership(true).await;
+        } else {
+            // Peer dropped below active -> maybe reclaim (spec 5, 7.3).
+            let was_peer = {
+                let st = self.state.lock().await;
+                st.state == OwnershipState::PeerOwns || st.state == OwnershipState::Yielding
+            };
+            if was_peer {
+                self.maybe_reclaim().await;
+            }
+        }
+    }
+
+    /// Feed an `AUDIO_SOURCE` event (spec 5, 7.3).
+    pub async fn on_audio_source(&self, src: &AudioSource) {
+        let local = self.aacp.local_mac().await;
+        let local_rev = self.aacp.local_mac_reversed().await;
+        let is_peer = src.mac != local && local_rev.as_deref() != Some(src.mac.as_str());
+
+        match src.r#type {
+            crate::bluetooth::aacp::AudioSourceType::None => {
+                // A `NONE` during a peer call is meaningless (spec 5): the firmware
+                // emits it periodically. Only consider reclaiming if the peer is no
+                // longer the active owner.
+                if is_peer {
+                    let st = self.state.lock().await;
+                    let was_peer = st.state == OwnershipState::PeerOwns;
+                    drop(st);
+                    if was_peer && !self.any_peer_active().await {
+                        info!("Peer NONE and no longer active; reclaiming.");
+                        self.maybe_reclaim().await;
+                    } else {
+                        debug!("Peer NONE ignored (peer still active or not in peer state).");
+                    }
+                }
+            }
+            crate::bluetooth::aacp::AudioSourceType::Call
+            | crate::bluetooth::aacp::AudioSourceType::Media => {
+                // The peer is actively using the AirPods. Do not trust the type field
+                // alone (spec 3.5: iOS sends MEDIA for real calls) — cross-check the
+                // peer's B-field. Yield if the peer is active or about to be.
+                if is_peer && (self.any_peer_active().await || src.r#type == crate::bluetooth::aacp::AudioSourceType::Call) {
+                    info!("Peer audio source active ({:?}); yielding.", src.r#type);
+                    self.yield_ownership(true).await;
+                }
+            }
+        }
+    }
+
+    /// Feed the firmware's ownership verdict (`OwnsConnection` control command).
+    pub async fn on_owns(&self, owns: bool) {
+        if owns {
+            let mut st = self.state.lock().await;
+            if st.state != OwnershipState::LinuxOwns && st.state != OwnershipState::Reclaiming {
+                debug!("Firmware verdict: we own; state -> LinuxOwns.");
+                st.state = OwnershipState::LinuxOwns;
+            }
+        } else {
+            info!("Firmware verdict: we lost ownership; yielding.");
+            self.yield_ownership(false).await;
+        }
+    }
+
+    /// Feed ear detection for the eviction guard (spec 7.4).
+    pub async fn on_ear_detection(&self, statuses: Vec<EarDetectionStatus>) {
+        self.state.lock().await.ear = statuses;
+    }
+
+    /// Start the periodic ghost-session monitor (spec 8.2). Re-evaluates the two
+    /// ghost conditions every second. Detection only — it never reclaims on its own
+    /// (no auto-action); the user triggers the repair explicitly.
+    pub fn start_ghost_monitor(&self) {
+        let arbiter = self.clone();
+        tokio::spawn(async move {
+            let mut interval = tokio::time::interval(GHOST_MONITOR_INTERVAL);
+            loop {
+                interval.tick().await;
+                arbiter.check_ghost_session().await;
+            }
+        });
+    }
+
+    /// Re-evaluate the ghost-session conditions (spec 8.2).
+    ///
+    /// * **Variant A**: a peer was engaged (B >= 0x10) and then stayed disengaged
+    ///   (B < 0x10) for > 17 s — it dropped the session but the firmware still thinks
+    ///   it is attached.
+    /// * **Variant B**: no non-local peer present for > 30 s — the peer vanished
+    ///   entirely but a stale session lingers.
+    ///
+    /// The own MAC is excluded (via `peers()`), so our own entry can never trip it.
+    async fn check_ghost_session(&self) {
+        let peers = self.aacp.peers().await;
+        let now = Instant::now();
+        let mut st = self.state.lock().await;
+
+        // Track per-peer B-field transitions. Use the APP1-conservative engagement
+        // test (spec 9.1): B-field threshold AND presence (not evicted).
+        for p in &peers {
+            if p.is_engaged_present() {
+                st.peer_last_engaged.insert(p.mac.clone(), now);
+                st.peer_last_disengaged.remove(&p.mac);
+            } else if st.peer_last_engaged.contains_key(&p.mac)
+                && !st.peer_last_disengaged.contains_key(&p.mac)
+            {
+                // Engaged earlier, now disengaged: start the variant-A timer.
+                st.peer_last_disengaged.insert(p.mac.clone(), now);
+            }
+        }
+        // Variant B: remember when a peer was last present (do not advance while absent).
+        if !peers.is_empty() {
+            st.last_peer_seen = Some(now);
+        }
+
+        // Variant A: a peer was engaged, then disengaged for > 17 s.
+        let mut ghost = false;
+        let mut reason = None;
+        for (mac, disengaged_at) in st.peer_last_disengaged.iter() {
+            if now - *disengaged_at > GHOST_A_DISENGAGED {
+                ghost = true;
+                reason = Some(format!(
+                    "peer {} disengaged (B < 0x10) for > {} s after being engaged (variant A)",
+                    mac,
+                    GHOST_A_DISENGAGED.as_secs()
+                ));
+                break;
+            }
+        }
+
+        // Variant B: no non-local peer present for > 30 s.
+        if !ghost
+            && let Some(last) = st.last_peer_seen
+            && now - last > GHOST_B_ABSENT
+        {
+            ghost = true;
+            reason = Some(format!(
+                "no non-local peer present for > {} s (variant B)",
+                GHOST_B_ABSENT.as_secs()
+            ));
+        }
+
+        // Clear the ghost if a peer is currently engaged (the session recovered).
+        if ghost && peers.iter().any(|p| p.is_engaged_present()) {
+            ghost = false;
+            reason = None;
+            st.peer_last_disengaged.clear();
+        }
+
+        if ghost != st.ghost_session {
+            if ghost {
+                warn!("Ghost session detected: {:?}", reason);
+            } else {
+                info!("Ghost session cleared.");
+            }
+            st.ghost_session = ghost;
+            st.ghost_reason = reason;
+        } else if ghost {
+            st.ghost_reason = reason;
+        }
+    }
+
+    /// Whether a ghost session is currently detected (spec 8.2).
+    pub async fn is_ghost_session(&self) -> bool {
+        self.state.lock().await.ghost_session
+    }
+
+    /// Human-readable reason for the current ghost session, if any (spec 8.2).
+    pub async fn ghost_reason(&self) -> Option<String> {
+        self.state.lock().await.ghost_reason.clone()
+    }
+
+    /// Explicitly repair a ghost session (spec 8.2): called only on the user's
+    /// explicit repair request (no auto-action). Clears the ghost state and performs
+    /// a guarded reclaim to re-assert Linux ownership.
+    pub async fn repair_ghost_session(&self) {
+        {
+            let mut st = self.state.lock().await;
+            st.ghost_session = false;
+            st.ghost_reason = None;
+            st.peer_last_disengaged.clear();
+        }
+        info!("User requested ghost-session repair; reclaiming.");
+        self.maybe_reclaim().await;
+    }
+
+    /// Yield to the peer: deactivate A2DP and pause media (spec 5). When
+    /// `send_release` is true, also send the RELEASE packet — used when *we* detect
+    /// the peer engaging. When the firmware itself tells us we lost ownership
+    /// (`OwnsConnection = false`), the RELEASE is redundant and skipped.
+    pub async fn yield_ownership(&self, send_release: bool) {
+        let mut st = self.state.lock().await;
+        if st.state == OwnershipState::Yielding || st.state == OwnershipState::PeerOwns {
+            debug!("Already yielded; skipping duplicate yield.");
+            return;
+        }
+        st.state = OwnershipState::Yielding;
+        st.guard_armed = false;
+        drop(st);
+
+        if send_release {
+            info!("Yielding: sending RELEASE and deactivating A2DP.");
+            let _ = self
+                .command_tx
+                .send((ControlCommandIdentifiers::OwnsConnection, vec![0x00]));
+        } else {
+            info!("Yielding: firmware already took ownership; deactivating A2DP.");
+        }
+        let mc = self.media.lock().await;
+        mc.pause_all_media().await;
+        // Snapshot the raw hardware volume before the peer takes over (spec 11.7) so
+        // it can be restored on reclaim.
+        mc.snapshot_volume().await;
+        mc.deactivate_a2dp_profile().await;
+        // Suppress the silence stream while the peer owns the device (spec 6.1).
+        mc.set_silence_suppressed(true);
+        drop(mc);
+
+        self.state.lock().await.state = OwnershipState::PeerOwns;
+    }
+
+    /// Begin a guarded reclaim (spec 5, 7.3). Verifies no peer is active, then arms
+    /// a short guard timer and re-verifies on expiry.
+    async fn maybe_reclaim(&self) {
+        {
+            let st = self.state.lock().await;
+            if st.reclaim_in_progress || st.guard_armed {
+                debug!("Reclaim already in flight or guard armed; skipping.");
+                return;
+            }
+        }
+        // Verify no peer sits at B >= 0x17 (spec 7.3).
+        if self.any_peer_active().await {
+            info!("Reclaim blocked: a peer is still active (B >= 0x17).");
+            return;
+        }
+        {
+            let mut st = self.state.lock().await;
+            st.guard_armed = true;
+            st.state = OwnershipState::Reclaiming;
+        }
+        info!("Peer released; arming {}s reclaim guard.", RECLAIM_GUARD.as_secs());
+
+        let arbiter = self.clone();
+        tokio::spawn(async move {
+            tokio::time::sleep(RECLAIM_GUARD).await;
+            arbiter.finish_reclaim().await;
+        });
+    }
+
+    /// Re-verify and perform the reclaim. The `reclaim_in_progress` flag is cleared
+    /// on every exit path (spec 5).
+    async fn finish_reclaim(&self) {
+        // Re-verify: if a peer re-asserted during the guard, cancel and stay yielded.
+        if self.any_peer_active().await {
+            info!("Reclaim guard expired but a peer re-asserted; staying yielded.");
+            let mut st = self.state.lock().await;
+            st.guard_armed = false;
+            st.state = OwnershipState::PeerOwns;
+            return;
+        }
+        {
+            let mut st = self.state.lock().await;
+            if st.reclaim_in_progress {
+                warn!("Reclaim already in progress; not running a second one.");
+                return;
+            }
+            st.reclaim_in_progress = true;
+            st.state = OwnershipState::Reclaiming;
+        }
+
+        info!("Reclaiming: sending CLAIM and activating A2DP.");
+        let _ = self
+            .command_tx
+            .send((ControlCommandIdentifiers::OwnsConnection, vec![0x01]));
+        let mc = self.media.lock().await;
+        mc.activate_a2dp_profile().await;
+        // Lift the silence-stream suppression now that we own the device (spec 6.1).
+        // The silence stream starts writing, which also keeps the codec engaged.
+        mc.set_silence_suppressed(false);
+        // Codec warm-up (spec 11.8): let the re-activated A2DP codec initialize before
+        // resuming, so the first burst of audio is not dropped or glitchy.
+        mc.codec_warmup().await;
+        // Restore the raw hardware volume (spec 11.7) before resuming playback.
+        mc.restore_volume().await;
+        mc.resume().await;
+        drop(mc);
+
+        // Clear the flag on the nominal path.
+        let mut st = self.state.lock().await;
+        st.reclaim_in_progress = false;
+        st.guard_armed = false;
+        st.state = OwnershipState::LinuxOwns;
+    }
+}
