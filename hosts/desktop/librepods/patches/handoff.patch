+/// Reverse the byte order of a colon-separated MAC (spec 3.5).
+///
+/// The same MAC appears in two different orders depending on the packet: in
+/// `CONNECTED_DEVICES` it is reversed relative to the local adapter address as
+/// reported by BlueZ, while in `AUDIO_SOURCE` it is not. Store both forms and
+/// compare against the right one, or the host mistakes its own events for a
+/// peer's.
+pub fn reverse_mac(mac: &str) -> String {
+    mac.split(':')
+        .filter_map(|s| u8::from_str_radix(s, 16).ok())
+        .rev()
+        .map(|b| format!("{:02X}", b))
+        .collect::<Vec<_>>()
