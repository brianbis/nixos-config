{ config, lib, pkgs, ... }:

# yzerd — the physical box, native NixOS.
#
# Everything hardware-shaped here is a fact read off the live host BEFORE the wipe
# (see README.md "Verified host topology"); nothing is generated by
# nixos-generate-config, because a file generated on a machine that no longer runs
# PVE cannot be diffed against the layout that made it. The devices are declared
# explicitly instead, so the config states the layout it wants rather than the
# layout it found.

{
  ### Filesystems: the layout the install creates.
  #
  # nvme0n1p3 (930.5G, currently LVM2 holding VG pve) is destroyed and recreated as
  # one labelled ext4 — nothing on the box needs LVM once PVE is gone, and a single
  # filesystem is one fewer thing that can drift. The label is the identity; PVE's
  # /dev/disk/by-label style naming survives the mode change.
  fileSystems."/" = {
    device = "LABEL=nixos-native";
    fsType = "ext4";
  };

  # nvme0n1p2 (1G vfat) is the ESP, mounted exactly where PVE mounted it. Reused,
  # never reformatted: the EFI entries in NVRAM reference it by geometry, and
  # rewriting it would invalidate them.
  fileSystems."/boot/efi" = {
    device = "/dev/nvme0n1p2";
    fsType = "vfat";
  };

  ### Bootloader: systemd-boot, and deliberately NOT touching EFI variables.
  #
  # Verified in this nixpkgs pin (nixos/modules/system/boot/loader/systemd-boot/):
  # canTouchEfiVariables=false makes the builder pass `--variables=no` to
  # `bootctl install` — the ESP copy still happens, including bootctl's fallback
  # binary at EFI/BOOT/bootx64.efi on nvme0n1p2. The surviving EFI entry
  # Boot0004 points at \EFI\BOOT\BOOTX64.EFI on that same partition (vfat names are
  # case-insensitive), so the box boots after the wipe with no NVRAM edit at all.
  # GRUB was NOT chosen: it needs a BIOS boot partition or an EFI-mode install that
  # writes NVRAM, and nvme0n1 has neither spare.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = false;
  boot.loader.efi.efiSysMountPoint = "/boot/efi";

  ### No swap: pve-swap is destroyed with p3, and an undeclared swapDevice keeps
  # the image honest about what the box actually uses. Revisit if the guest needs
  # headroom once it runs here.
  swapDevices = [ ];

  networking.hostName = "yzerd";
  networking.networkmanager.enable = false;

  ### Wired network: PVE's proven static topology, restated as networkd.
  #
  # /etc/network/interfaces on the PVE host said, verbatim:
  #   auto vmbr0
  #   iface vmbr0 inet static
  #       address 192.168.5.186/22
  #       gateway 192.168.4.1
  #       bridge-ports enp4s0
  # systemd-networkd's peer-with-mask form is the direct translation of that
  # address/gateway idiom, applied to the real interface enp4s0. This is what keeps
  # the box reachable at 192.168.5.186 over ssh once PVE — and its ifupdown — is
  # gone.
  #
  # `address`/`gateway` are typed list options in this pin
  # (nixos/modules/system/boot/networkd.nix: types.listOf types.str, rendered as
  # Address=/Gateway= lines in the unit's [Network] section). The free-form
  # `config.Address` spelling this first tried is NOT an option in this pin and
  # nix rejected it at evaluation — the made-up name was caught before it could
  # render into a unit systemd would have silently ignored.
  networking.useNetworkd = true;
  # without this the eval warns: `systemd.network.enable = true` +
  # `networking.useDHCP = true` + `networking.useNetworkd = false` lets networkd
  # and dhcpcd manage the same interface. The address is static here, so DHCP is
  # off by declaration rather than by luck.
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-yz-enp4s0" = {
    name = "enp4s0";
    address = [ "192.168.5.186/22" ];
    gateway = [ "192.168.4.1" ];
  };

  ### Remote control: key first, declared password as the fallback, because the
  # native box has no serial console and no `qm terminal` to lean on.
  services.openssh.enable = true;
  services.openssh.settings.PasswordAuthentication = lib.mkDefault true;

  users.users.b = {
    description = "b on the native box";
    group = "b";
    # the pin asserts exactly one of isSystemUser/isNormalUser is set
    isNormalUser = true;
    # `home`, not `homeDirectory`: this pin's users module renamed the option, and
    # nix rejects the made-up name at evaluation (caught, not assumed).
    home = "/home/b";
    # video owns /dev/nvidia* (this repo's own note in hosts/desktop/host.nix: a CUDA
    # consumer needs it to open the GPU device nodes); audio owns /dev/snd, whose nodes
    # the booted box created root:audio (pcmC0D3p etc.) while b belonged to neither
    # group. Both are driver-access facts, not policy taste.
    extraGroups = [ "wheel" "video" "audio" ];
    password = "yzerd-native";
    # Both keys the agent side can present: ha_key (IdentitiesOnly for the
    # proxmox-186 host block) and id_ed25519. Authorizing both means a new Host
    # block in ~/.ssh/config is a convenience, not a precondition.
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIDKuUwgF6tCaTogYB+/iP5HH/G9v3/fuNfFh1lpoQqm dsh-agent"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF8xmNGugmkzaMVtKWHY1EnD4I4oe1PW34IofWMNzcxi llm@jail"
    ];
  };
  users.groups.b = { };

  security.sudo.wheelNeedsPassword = false;

  time.timeZone = "America/Phoenix";

  # Strata (the coder server, one file over at ./llm/strata): enabled so the
  # units and the weights staging EXIST, but nothing loads at boot — the serve
  # unit has no wantedBy and strata-prep.target is manual, so `systemctl start
  # strata-coder-serve` is the only thing that ever puts ~23 GB on the card.
  services.strata.enable = true;

  ### Deliberately NOT declared yet, and why:
  #  * the GPU driver — it IS declared now, one file over in ./nvidia.nix (the card
  #    answered AD102 in the boot journal and nothing owned it). What stays open is
  #    the card's residency policy: no llm-gate on this box yet, so powerManagement
  #    is off there rather than inherited from hosts/desktop/nvidia.nix.
  #  * the guest VM (the NixOS-under-NixOS setup that replaces vmid 100). QEMU argv
  #    and the disk image are runtime state; the unit that owns it belongs in a
  #    later revision, once the box boots natively and the pin is known.
  system.stateVersion = "26.11";
}
