switch:
    sudo nixos-rebuild switch
    git add .
    git commit -m "NixOS rebuild"
    git push
alias sw := switch
alias s := switch
alias apply := switch
alias rebuild := switch
alias rebuild-switch := switch
alias rs := switch
alias update := switch
alias up := switch
alias reload := switch
alias refresh := switch
alias deploy := switch
alias deploy-local := switch
alias activate := switch
alias go := switch
